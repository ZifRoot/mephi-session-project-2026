#!/bin/bash
# Цвета для вывода
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color
echo "=========================================="
echo "   ПРОВЕРКА ВЫПОЛНЕНИЯ ЗАДАНИЯ"
echo "=========================================="
# Счётчик ошибок
ERRORS=0
# Функция проверки с выводом
check() {     if eval "$2"; then         echo -e "${GREEN}✓${NC} $1";     else         echo -e "${RED}✗${NC} $1";         ((ERRORS++));     fi; }
# ------------------- Раздел 1 -------------------
echo -e "\n${YELLOW}--- Раздел 1. Установка дистрибутива ---${NC}"
# 1.1 Сетевая настройка (DHCP)
check "Сетевой интерфейс имеет IP-адрес (не loopback)"     "ip -4 a show | grep -E 'inet ' | grep -v '127.0.0.1' | grep -q ."
check "Пинг до 8.8.8.8 проходит"     "ping -c 1 -W 2 8.8.8.8 &>/dev/null"
# 1.2 Файловая система
check "Раздел /data-mephi примонтирован"     "mount | grep -q '/data-mephi'"
check "В /etc/fstab есть запись с LABEL=MEPHI_DATA"     "grep -q 'LABEL=MEPHI_DATA' /etc/fstab"
# 1.3 Пользователь mephi-admin
check "Пользователь mephi-admin существует"     "id mephi-admin &>/dev/null"
check "Пользователь mephi-admin в группе wheel"     "groups mephi-admin | grep -q wheel"
# ------------------- Раздел 2 -------------------
echo -e "\n${YELLOW}--- Раздел 2. Управление программным обеспечением ---${NC}"
# 2.1 Обновление дистрибутива (проверяем наличие истории dnf)
check "История dnf сохранена (dnf.out)"     "[ -f ~/project_artifacts/dnf.out ] || [ -f ~/dnf.out ]"
# 2.2 Установка пакетов
check "Установлен Apache (httpd)"     "rpm -q httpd &>/dev/null"
check "Установлен tcpdump"     "rpm -q tcpdump &>/dev/null"
check "Установлен libcap-ng-utils"     "rpm -q libcap-ng-utils &>/dev/null"
# ------------------- Раздел 3 -------------------
echo -e "\n${YELLOW}--- Раздел 3. Управление сервисами ---${NC}"
# 3.1 Apache запущен и включен
check "Apache запущен (active)"     "systemctl is-active httpd &>/dev/null"
check "Apache включен в автозагрузку"     "systemctl is-enabled httpd &>/dev/null"
# 3.2 mod_userdir
check "Модуль mod_userdir загружен"     "httpd -M 2>/dev/null | grep -q userdir"
check "Конфигурация userdir присутствует"     "[ -f /etc/httpd/conf.d/userdir.conf ]"
# 3.3 Журналирование
check "Логи Apache за 5 минут сохранены (httpd_logs)"     "[ -f ~/project_artifacts/httpd_logs ]"
# ------------------- Раздел 4 -------------------
echo -e "\n${YELLOW}--- Раздел 4. Управление доступом ---${NC}"
# 4.1 Пользователь user1 и срок действия пароля
check "Пользователь user1 существует"     "id user1 &>/dev/null"
check "Срок действия пароля user1 установлен на 90 дней"     "chage -l user1 2>/dev/null | grep -q 'Maximum.*: 90'"
# 4.2 Capabilities для tcpdump
check "SUID-бит снят с tcpdump"     "[ ! -u /usr/sbin/tcpdump ]"
check "Capabilities добавлены (cap_net_raw, cap_net_admin)"     "getcap /usr/sbin/tcpdump 2>/dev/null | grep -q 'cap_net_raw,cap_net_admin+ep'"
# ------------------- Раздел 5 -------------------
echo -e "\n${YELLOW}--- Раздел 5. Аутентификация ---${NC}"
# 5.1 Блокировка root
check "Root заблокирован через PAM (sshd)"     "grep -q 'pam_listfile.so.*denied_users' /etc/pam.d/sshd"
check "Root заблокирован через PAM (login)"     "grep -q 'pam_listfile.so.*denied_users' /etc/pam.d/login"
check "Файл denied_users существует и содержит root"     "[ -f /etc/ssh/denied_users ] && grep -q '^root$' /etc/ssh/denied_users"
# 5.2 Минимальная длина пароля
check "Минимальная длина пароля установлена в 10"     "grep -q 'minlen = 10' /etc/security/pwquality.conf"
# ------------------- Раздел 6 -------------------
echo -e "\n${YELLOW}--- Раздел 6. Тестирование ---${NC}"
# 6.1 Страница user1
check "Директория public_html существует"     "[ -d /home/user1/public_html ]"
check "Файл index.html существует"     "[ -f /home/user1/public_html/index.html ]"
# Проверяем содержимое страницы (ожидаем "Hello from Student")
check "Страница user1 доступна через curl и содержит правильный текст"     "curl -s http://localhost/~user1 | grep -q 'Hello from Student'"
# 6.2 Скриншот
check "Скриншот mephi-screenshot.png сохранён"     "[ -f ~/project_artifacts/mephi-screenshot.png ]"
# ------------------- Раздел 7 -------------------
echo -e "\n${YELLOW}--- Раздел 7. Публикация на GitHub ---${NC}"
# 7.1 Артефакты
FILES=(history.out ip.out ping.out stat.out getcap.out dnf.out)
for file in "${FILES[@]}"; do     check "Артефакт $file присутствует"         "[ -f ~/project_artifacts/$file ]"; done
# Проверяем, что системные файлы скопированы
check "Скопирован /etc/fstab"     "[ -f ~/project_artifacts/fstab ]"
check "Скопирован /etc/passwd"     "[ -f ~/project_artifacts/passwd ]"
check "Скопирован /etc/shadow"     "[ -f ~/project_artifacts/shadow ]"
check "Скопирован /etc/security/pwquality.conf"     "[ -f ~/project_artifacts/pwquality.conf ]"
# 7.2–7.4 Проверка Git репозитория (опционально)
if [ -d ~/project_artifacts/.git ]; then     echo -e "${GREEN}✓${NC} Репозиторий Git инициализирован"; else     echo -e "${RED}✗${NC} Репозиторий Git не инициализирован";     ((ERRORS++)); fi
# ------------------- Итог -------------------
echo ""
if [ $ERRORS -eq 0 ]; then     echo -e "${GREEN}ВСЕ ПРОВЕРКИ ПРОЙДЕНЫ УСПЕШНО""{NC}"; else     echo -e "${RED}ОБНАРУЖЕНО $ERRORS ОШИБОК. ПРОВЕРЬТЕ ПУНКТЫ ВЫШЕ.${NC}"; fi
echo "=========================================="
cat > ~/check_all.sh << 'EOF'
#!/bin/bash

# Цвета
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "========================================="
echo "  Проверка выполнения проекта MEPHI"
echo "  (функциональность + артефакты)"
echo "========================================="
echo

# Функция для вывода результата проверки
check() {
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}✅ $1${NC}"
    else
        echo -e "${RED}❌ $1${NC}"
        FAILED=1
    fi
}

# Функция для проверки наличия файла-артефакта
check_file() {
    if [ -f "$1" ]; then
        echo -e "${GREEN}✅ $2${NC}"
    else
        echo -e "${RED}❌ $2 (файл отсутствует)${NC}"
        FAILED=1
    fi
}

FAILED=0

# ---- 1. Сеть ----
echo "--- 1. Сетевая настройка (DHCP) ---"
ping -c 1 8.8.8.8 &>/dev/null
check "Пинг до 8.8.8.8 проходит"
ip a | grep -E "eth0|ens3|enp" | grep "inet " &>/dev/null
check "Интерфейс имеет IP по DHCP"

# ---- 2. Файловая система ----
echo "--- 2. Файловая система (MEPHI_DATA) ---"
sudo blkid | grep -q "MEPHI_DATA"
check "Раздел с меткой MEPHI_DATA существует"
mount | grep -q "/data-mephi"
check "Точка монтирования /data-mephi примонтирована"
grep -q "MEPHI_DATA" /etc/fstab
check "Запись в /etc/fstab присутствует"

# ---- 3. Пользователи ----
echo "--- 3. Пользователи и права ---"
id mephi-admin &>/dev/null
check "Пользователь mephi-admin существует"
groups mephi-admin | grep -q wheel
check "mephi-admin в группе wheel (администратор)"
id user1 &>/dev/null
check "Пользователь user1 существует"
sudo chage -l user1 | grep -q "Password expires.*$(date -d '+90 days' +'%b %d, %Y')" 2>/dev/null
check "Срок действия пароля user1 установлен (90 дней)"

# ---- 4. Пакеты ----
echo "--- 4. Установка пакетов ---"
rpm -q httpd &>/dev/null
check "Apache (httpd) установлен"
rpm -q tcpdump &>/dev/null
check "tcpdump установлен"
rpm -q libcap-ng-utils &>/dev/null
check "libcap-ng-utils установлен"

# ---- 5. Веб-сервер Apache ----
echo "--- 5. Веб-сервер Apache ---"
systemctl is-active --quiet httpd
check "Apache запущен"
systemctl is-enabled --quiet httpd
check "Apache включён в автозагрузку"
sudo httpd -M 2>/dev/null | grep -q userdir_module
check "Модуль mod_userdir загружен"
# Проверяем доступность страницы ~user1
if curl -s -o /dev/null -w "%{http_code}" http://localhost/~user1 | grep -q 200; then
    echo -e "${GREEN}✅ Страница ~user1 доступна (HTTP 200)${NC}"
else
    echo -e "${RED}❌ Страница ~user1 не доступна (код != 200)${NC}"
    FAILED=1
fi

# ---- 6. Capabilities tcpdump ----
echo "--- 6. Capabilities tcpdump ---"
getcap /usr/sbin/tcpdump | grep -q "cap_net_admin,cap_net_raw+ep"
check "capabilities для tcpdump настроены"

# ---- 7. Блокировка root ----
echo "--- 7. Блокировка root (PAM) ---"
grep -q "pam_listfile.so" /etc/pam.d/sshd
check "PAM-модуль в sshd"
grep -q "pam_listfile.so" /etc/pam.d/login
check "PAM-модуль в login"
[ -f /etc/ssh/denied_users ] && grep -q "^root$" /etc/ssh/denied_users
check "Файл denied_users содержит root"

# ---- 8. Минимальная длина пароля ----
echo "--- 8. Минимальная длина пароля ---"
grep -q "^minlen = 10" /etc/security/pwquality.conf
check "minlen = 10 в pwquality.conf"

# ---- 9. Артефакты проекта ----
echo "--- 9. Проверка наличия артефактов (кроме history.out) ---"
cd ~/project_artifacts 2>/dev/null || mkdir -p ~/project_artifacts
check_file "ip.out" "ip.out"
check_file "ping.out" "ping.out"
check_file "fstab" "fstab (копия /etc/fstab)"
check_file "passwd" "passwd (копия /etc/passwd)"
check_file "shadow" "shadow (копия /etc/shadow)"
check_file "dnf.out" "dnf.out"
check_file "stat.out" "stat.out"
check_file "httpd_logs" "httpd_logs"
check_file "getcap.out" "getcap.out"
check_file "pwquality.conf" "pwquality.conf (копия)"
check_file "index.html" "index.html"
check_file "mephi-screenshot.png" "mephi-screenshot.png"

# ---- Итог ----
echo
echo "========================================="
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}✅ ВСЕ ПРОВЕРКИ ПРОЙДЕНЫ УСПЕШНО!${NC}"
    echo "Теперь можно сохранить историю команд:"
    echo "  history > ~/project_artifacts/history.out"
    echo "и запушить на GitHub."
else
    echo -e "${RED}❌ ЕСТЬ ОШИБКИ. Исправьте их перед сдачей.${NC}"
fi
echo "========================================="
EOF

chmod +x ~/check_all.sh
~/check_all.sh 
cat > ~/fix_password_expiry.sh << 'EOF'
#!/bin/bash
echo "Устанавливаем срок действия пароля user1 = 90 дней"
sudo chage -M 90 user1
sudo chage -l user1 | grep "Password expires"
EOF

chmod +x ~/fix_password_expiry.sh
~/fix_password_expiry.sh
~/check_all.sh 
cat > ~/fix_tcpdump_cap.sh << 'EOF'
#!/bin/bash
echo "Снимаем SUID-бит с tcpdump"
sudo chmod u-s /usr/sbin/tcpdump

echo "Добавляем capabilities"
sudo setcap cap_net_raw,cap_net_admin+ep /usr/sbin/tcpdump

echo "Проверяем"
getcap /usr/sbin/tcpdump
EOF

chmod +x ~/fix_tcpdump_cap.sh
~/fix_tcpdump_cap.sh
~/check_all.sh 
cat > ~/fix_denied_users.sh << 'EOF'
#!/bin/bash
echo "Создаём файл /etc/ssh/denied_users с root"
echo "root" | sudo tee /etc/ssh/denied_users

echo "Проверяем содержимое"
cat /etc/ssh/denied_users

echo "Перезапускаем sshd"
sudo systemctl restart sshd
EOF

chmod +x ~/fix_denied_users.sh
~/fix_denied_users.sh
~/check_all.sh 
git initbasename
git init
cd r
git init
 git config --global init.defaultBranch main
git init
curl -L curl http://localhost/~user1
exit
dnf history list
dnf history list > ~/dnf.out
dnf update -y --exclude=kernel*,systemd*,selinux-policy*
dnf history list > ~/dnf1.out
./check_mephi.sh
~/check_all.sh 
./check_mephi.sh > check_mephi.log
clear
cd r
./check_mephi.sh > check_mephi.log
chmod +x *.sh
./generate_artifacts.sh 
./check_mephi.sh > check_mephi.log
sudo systemctl restart httpd
curl http://localhost/~user1
curl -L http://localhost/~user1
./generate_artifacts.sh 
./check_mephi.sh > check_mephi.log
cat ~/.bash_history > history.out
./check_mephi.sh > check_mephi.log
./generate_artifacts.sh 
./check_mephi.sh > check_mephi.log
./dhcp_and_artifacts.sh 
screen -S dhcp
nohup sudo ./dhcp_and_artifacts.sh > dhcp.log 2>&1 &
tail -f dhcp.log  # следить за логом
./check_mephi.sh > check_mephi.log
exit
curl -L -s http://localhost/~user1
cd r/
./dhcp_and_artifacts.sh 
ls
./dhcp_and_artifacts.sh 
exit
