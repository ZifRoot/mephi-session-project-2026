ls
# Создаём папку для артефактов (если не существует)
mkdir -p ~/project_artifacts
cd ~/project_artifacts
# 1. Устанавливаем hostname
sudo hostnamectl set-hostname mephi-2026.domain.local
# Проверяем
hostnamectl
# 2. Загружаем модуль dummy (если ещё не загружен)
sudo modprobe dummy
# Проверяем, что модуль загружен
lsmod | grep dummy
# 3. Создаём интерфейс dummy0 с IP 192.168.1.100/24
sudo ip link add dummy0 type dummy
sudo ip addr add 192.168.1.100/24 dev dummy0
sudo ip link set dummy0 up
# 4. Добавляем на loopback адрес 192.168.1.1/32 (чтобы пинговать "шлюз")
sudo ip addr add 192.168.1.1/32 dev lo
# 5. Проверяем, что интерфейсы поднялись
ip a show dummy0
ip a show lo | grep 192.168.1.1
# Создаём скрипт
sudo tee /usr/local/bin/mephi-net-setup.sh > /dev/null << 'EOF'
#!/bin/bash
# Поднимаем dummy0 и добавляем IP на lo
modprobe dummy
ip link add dummy0 type dummy 2>/dev/null || true
ip addr add 192.168.1.100/24 dev dummy0 2>/dev/null || true
ip link set dummy0 up
ip addr add 192.168.1.1/32 dev lo 2>/dev/null || true
# (позже сюда добавим создание loop-устройства для диска)
EOF

sudo chmod +x /usr/local/bin/mephi-net-setup.sh
# Создаём systemd-сервис
sudo tee /etc/systemd/system/mephi-network.service > /dev/null << 'EOF'
[Unit]
Description=MEPHI network setup (dummy0, loopback IP, loop device)
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/mephi-net-setup.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

# Включаем сервис
sudo systemctl enable mephi-network.service
# Запускаем сейчас (если ещё не запускали вручную)
sudo systemctl start mephi-network.service
# Проверяем статус
sudo systemctl status mephi-network.service
# Пинг до шлюза (192.168.1.1) – идёт локально через lo
ping -c 4 192.168.1.1
# Пинг до 8.8.8.8 – идёт через реальный интерфейс (должен работать, если сеть настроена)
ping -c 4 8.8.8.8
{   echo "=== Ping to 192.168.1.1 ===";   ping -c 4 192.168.1.1;   echo "=== Ping to 8.8.8.8 ===";   ping -c 4 8.8.8.8; } > ~/project_artifacts/network_check.txt
cat ~/project_artifacts/network_check.txt
sudo dnf install -y nginx tcpdump libcap-ng-utils
rpm -q nginx tcpdump libcap-ng-utils
# Скачиваем в текущую папку (project_artifacts)
sudo dnf download tcpdump --destdir=~/project_artifacts
# Проверяем, что файл появился
ls -l ~/project_artifacts/tcpdump*.rpm
sudo dnf download tcpdump --destdir=~/project_artifacts
# Переустановим пакет через rpm (для демонстрации)
sudo rpm -ivh ~/project_artifacts/tcpdump-*.rpm --force
ls -la ~/project_artifacts/
sudo dnf download tcpdump --destdir=/root/project_artifacts
# Переустановим пакет через rpm (для демонстрации)
sudo rpm -ivh ~/project_artifacts/tcpdump-*.rpm --force
sudo dd if=/dev/zero of=/tmp/mephi_data.img bs=1M count=512
sudo losetup -fP /tmp/mephi_data.img
# Узнаём имя (например, /dev/loop0)
LOOP=$(sudo losetup -l | grep mephi_data | awk '{print $1}')
echo "Loop device: $LOOP"
sudo parted $LOOP mklabel msdos
sudo parted $LOOP mkpart primary ext4 0% 100%
sudo partprobe $LOOP
# Проверяем, что появился /dev/loop0p1
ls -l $LOOP*
sudo mkfs.ext4 -L MEPHI_DATA ${LOOP}p1
sudo mkdir -p /data/mephi-web
sudo mount ${LOOP}p1 /data/mephi-web
# Проверяем
df -h /data/mephi-web
echo "LABEL=MEPHI_DATA /data/mephi-web ext4 defaults,_netdev,nofail 0 0" | sudo tee -a /etc/fstab
# Проверяем
cat /etc/fstab | grep MEPHI_DATA
cat /etc/fstab
rpm -q tcpdump
sudo tee /usr/local/bin/mephi-net-setup.sh > /dev/null << 'EOF'
#!/bin/bash
# Поднимаем dummy0 и добавляем IP на lo
modprobe dummy
ip link add dummy0 type dummy 2>/dev/null || true
ip addr add 192.168.1.100/24 dev dummy0 2>/dev/null || true
ip link set dummy0 up
ip addr add 192.168.1.1/32 dev lo 2>/dev/null || true

# Создаём loop-устройство для образа, если он существует
if [ -f /tmp/mephi_data.img ]; then
    losetup -fP /tmp/mephi_data.img 2>/dev/null || true
    # Монтируем /data/mephi-web, если ещё не примонтировано
    mount /data/mephi-web 2>/dev/null || true
fi
EOF

sudo chmod +x /usr/local/bin/mephi-net-setup.sh
cat /usr/local/bin/mephi-net-setup.sh 
reboot
